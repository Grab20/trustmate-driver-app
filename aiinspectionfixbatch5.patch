From 7f015430b778163cb96d7cb6f7c29e232fca7d4e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 20 Jul 2026 19:25:57 +0000
Subject: [PATCH] Fix AI inspection analysis never completing for the owner
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: every weekly_checkin inspection in the database had
ai_analyzed_at = null — the edge function silently skipped analysis
whenever photo_urls.length didn't exactly equal 9 (today's shot count),
returning 200 without ever writing to the row. The 5 existing inspections
all had 6 photos (pre-dating the 9-shot redesign), so none of them were
ever analyzed, and the owner's report screen was stuck showing "AI review
in progress" forever with no way to tell a skip from a still-pending call.

- analyze-inspection edge function (deployed v5): every exit path now
  writes a terminal ai_analysis + ai_analyzed_at, including the
  not-applicable skip, a missing GEMINI_API_KEY, a failed photo download,
  a failed Gemini request, and any uncaught error. Nothing can fall through
  and leave a row silently unanalyzed anymore.
- Backfilled the 5 stuck legacy inspections directly so their report
  screens immediately show "AI review unavailable" instead of an eternal
  spinner.
- New useRetryPendingAnalysis hook: the owner's Vehicle Health Report
  screen and the inline InspectionReviewCard now re-invoke analysis once
  when they encounter an inspection that's still unanalyzed, so a failed
  fire-and-forget call from submission time self-heals the next time
  anyone actually looks at it, instead of requiring a new inspection to be
  submitted to notice.
---
 .../driver/inspection/[inspectionId].tsx      |  3 +++
 .../src/components/InspectionReviewCard.tsx   |  4 +++-
 mobile/src/hooks/useInspections.ts            | 21 +++++++++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/mobile/app/owner/driver/inspection/[inspectionId].tsx b/mobile/app/owner/driver/inspection/[inspectionId].tsx
index bf830d70..bf2d7ab6 100644
--- a/mobile/app/owner/driver/inspection/[inspectionId].tsx
+++ b/mobile/app/owner/driver/inspection/[inspectionId].tsx
@@ -6,6 +6,7 @@ import {
   useInspectionReport,
   useWeeklyInspectionsForCar,
   useReviewInspection,
+  useRetryPendingAnalysis,
 } from '../../../../src/hooks/useInspections'
 import { useCar } from '../../../../src/hooks/useCar'
 import { useCarReferencePhotos } from '../../../../src/hooks/useCarReferencePhotos'
@@ -96,6 +97,8 @@ export default function InspectionHealthReportScreen() {
 
   const driverRecord = useMemo(() => computeDriverRecord(weeklyInspections ?? []), [weeklyInspections])
 
+  useRetryPendingAnalysis(inspection)
+
   if (isInspectionLoading || isHistoryLoading || !inspection) return <LoadingScreen />
 
   const currentInspectionId = inspection.id
diff --git a/mobile/src/components/InspectionReviewCard.tsx b/mobile/src/components/InspectionReviewCard.tsx
index 3afbfbb3..0144b08b 100644
--- a/mobile/src/components/InspectionReviewCard.tsx
+++ b/mobile/src/components/InspectionReviewCard.tsx
@@ -3,7 +3,7 @@ import { View, StyleSheet, Pressable } from 'react-native'
 import { Text, Card, Button, TextInput, Icon } from 'react-native-paper'
 import { useRouter } from 'expo-router'
 import type { Tables } from '../types/database'
-import { useReviewInspection } from '../hooks/useInspections'
+import { useReviewInspection, useRetryPendingAnalysis } from '../hooks/useInspections'
 import { InspectionPhotoThumbnail } from './InspectionPhotoThumbnail'
 import { AIAnalysisSummary } from './AIAnalysisSummary'
 import { IconBadge } from './IconBadge'
@@ -35,6 +35,8 @@ export function InspectionReviewCard({
   const reviewInspection = useReviewInspection(driverId)
   const [comment, setComment] = useState(inspection.owner_review_comment ?? '')
 
+  useRetryPendingAnalysis(inspection)
+
   const reviewStatus = inspection.owner_review_status ?? 'pending'
   const statusConfig = STATUS_CONFIG[reviewStatus] ?? STATUS_CONFIG.pending
   const canReview = reviewStatus === 'pending'
diff --git a/mobile/src/hooks/useInspections.ts b/mobile/src/hooks/useInspections.ts
index ef69f958..cd9e357d 100644
--- a/mobile/src/hooks/useInspections.ts
+++ b/mobile/src/hooks/useInspections.ts
@@ -1,9 +1,30 @@
+import { useEffect, useRef } from 'react'
 import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
 import { supabase } from '../lib/supabase'
 import { uploadInspectionPhoto } from '../lib/uploadInspectionPhoto'
 import { useAuthStore } from '../stores/authStore'
 import type { Tables } from '../types/database'
 
+// A submission's fire-and-forget analyze-inspection call can fail silently
+// (cold start, transient network error) and leave ai_analyzed_at null
+// forever, with no owner-facing signal that anything went wrong. Retrying
+// once whenever a report screen opens on an unanalyzed inspection lets it
+// self-heal instead of getting stuck showing "in progress" indefinitely.
+export function useRetryPendingAnalysis(
+  inspection: Pick<Tables<'vehicle_inspections'>, 'id' | 'ai_analyzed_at' | 'inspection_type'> | null | undefined,
+) {
+  const attemptedId = useRef<string | null>(null)
+
+  useEffect(() => {
+    if (!inspection) return
+    if (inspection.inspection_type !== 'weekly_checkin') return
+    if (inspection.ai_analyzed_at) return
+    if (attemptedId.current === inspection.id) return
+    attemptedId.current = inspection.id
+    supabase.functions.invoke('analyze-inspection', { body: { inspectionId: inspection.id } }).catch(() => {})
+  }, [inspection])
+}
+
 export function useInspectionHistory() {
   const userId = useAuthStore((s) => s.session?.user.id)
 
