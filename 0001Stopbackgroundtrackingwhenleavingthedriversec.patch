From f5b21ce08f39feca1fa9de646274d51f42464c10 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 4 Aug 2026 14:18:47 +0000
Subject: [PATCH] Stop background tracking when leaving the driver section
 (dual-role accounts)

useAutoTripTracking is only mounted from the driver tab layout, but nothing
previously stopped the native background location task when that layout
unmounts -- only 'no active rental' did. For a driver+owner dual-role
account, switching to Owner view left tracking running in the background,
attributing that movement (walking around, driving elsewhere) to the
driver profile. The app should only ever track the driver, not whoever
is currently holding the phone.

Added a second effect with an empty dependency array so it fires only on
true unmount (navigating out of the driver section, or signing out) --
kept separate from the existing sync effect, which already correctly
handles rental details simply changing while the layout stays mounted.
---
 mobile/src/hooks/useAutoTripTracking.ts | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/mobile/src/hooks/useAutoTripTracking.ts b/mobile/src/hooks/useAutoTripTracking.ts
index aa0ce590..4cd53194 100644
--- a/mobile/src/hooks/useAutoTripTracking.ts
+++ b/mobile/src/hooks/useAutoTripTracking.ts
@@ -78,5 +78,23 @@ export function useAutoTripTracking(): AutoTripPermissionStatus {
     }
   }, [userId, carId, applicationId])
 
+  // This hook is only mounted from the driver tab layout, so tearing down here
+  // means the signed-in user has navigated out of the driver section entirely
+  // (signed out, or — for a dual driver+owner account — switched to Owner
+  // view). Without this, a dual-role account's background tracking kept
+  // running while they browsed as the owner, attributing that movement to
+  // the driver profile: the app should only ever track the driver, not
+  // whoever happens to be holding the phone. Deliberately a separate effect
+  // with an empty dependency array — it must fire only on true unmount, not
+  // on every rental-detail change the sync effect above already handles.
+  useEffect(() => {
+    return () => {
+      Location.hasStartedLocationUpdatesAsync(BACKGROUND_LOCATION_TASK)
+        .then((isRegistered) => (isRegistered ? Location.stopLocationUpdatesAsync(BACKGROUND_LOCATION_TASK) : undefined))
+        .catch(() => {})
+      setAutoTripContext(null)
+    }
+  }, [])
+
   return status
 }
