From 32712ed823e635d6a6d24499b5881a4980e09718 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 4 Aug 2026 12:56:23 +0000
Subject: [PATCH 4/5] Prevent double-submitting an inspection (root cause of
 driver-vs-driver baseline bug)

Diagnosed from live data: two weekly_checkin inspections were created 0.377
seconds apart for the same driver/car. The analyze-inspection edge function
picks the most recent prior inspection as its per-shot baseline, so the
second (near-duplicate) submission got compared against the first one's
photos from the same moment -- driver photos vs driver photos, never
reaching the owner's actual reference baseline.

handleSubmit's upload work runs before submitInspection.isPending flips
true (that only starts once mutateAsync itself fires), so the button's
disabled prop didn't block a second tap landing during that window. Added
a ref-based guard set synchronously on the very first call, before any
await, so a rapid second tap can't race it the way the disabled prop could.

Companion server-side fix (analyze-inspection edge function, deployed
directly to Supabase -- doesn't need this app rebuild) now also ignores a
'prior inspection' if it's under 10 minutes old, falling back to the
owner's reference photos instead -- defense in depth against any other
path that could produce a near-duplicate submission.
---
 mobile/app/(app)/rental/inspections/new.tsx | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/mobile/app/(app)/rental/inspections/new.tsx b/mobile/app/(app)/rental/inspections/new.tsx
index 8630d970..d4c98450 100644
--- a/mobile/app/(app)/rental/inspections/new.tsx
+++ b/mobile/app/(app)/rental/inspections/new.tsx
@@ -1,4 +1,4 @@
-import { useState } from 'react'
+import { useRef, useState } from 'react'
 import { View, StyleSheet, ScrollView, Alert } from 'react-native'
 import { Text, TextInput, Button } from 'react-native-paper'
 import * as ImagePicker from 'expo-image-picker'
@@ -106,8 +106,18 @@ export default function NewInspectionScreen() {
     }
   }
 
+  // A ref, not state — the uploads below happen before submitInspection.isPending
+  // ever flips true (that only starts once mutateAsync itself fires), so a second
+  // tap landing during that window wasn't blocked by the button's disabled prop
+  // and could fire a full second submission, producing two near-duplicate
+  // inspection rows a fraction of a second apart. A ref guard is set synchronously
+  // on the very first call, before any await, so it can't be raced the same way.
+  const isSubmittingRef = useRef(false)
+
   async function handleSubmit() {
     if (!activeRental?.car_id || !userId || !allShotsCaptured) return
+    if (isSubmittingRef.current) return
+    isSubmittingRef.current = true
     try {
       const draftPhotoPaths: string[] = []
       for (const key of ALL_SHOTS) {
@@ -131,6 +141,8 @@ export default function NewInspectionScreen() {
       router.back()
     } catch (err) {
       Alert.alert('Submission failed', err instanceof Error ? err.message : 'Unknown error')
+    } finally {
+      isSubmittingRef.current = false
     }
   }
 
