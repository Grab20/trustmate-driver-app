{
  "expo": {
    "name": "TrustMate Driver",
    "slug": "trustmate-driver",
    "scheme": "trustmatedriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrustMate Driver uses your location to track distance and route while a trip is active. Location is only recorded while the app is open."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TrustMate Driver needs access to your photos to attach vehicle inspection photos.",
          "cameraPermission": "TrustMate Driver needs access to your camera to take vehicle inspection photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "co.za.trustmate.driver"
},
   "android": {
  "package": "co.za.trustmate.driver",
  "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
         "apiKey": "AIzaSyDk•••••••••••••••••••••••••••••••"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "co.za.trustmate.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4fdda38-f7e5-4387-a122-7a758e9b3e46"
      }
    }
  }
}
