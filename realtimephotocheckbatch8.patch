From 45c6dfe8d798adce9095aebbce2d29e0fa1920a9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 20 Jul 2026 20:18:39 +0000
Subject: [PATCH 1/3] Add missing expo-font peer dependency
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

expo doctor flagged this during a local EAS build: @expo/vector-icons
(used throughout the app for every icon — tab bar, badges, buttons)
requires expo-font as a peer dependency, which was never installed. It
went unnoticed because Expo Go bundles its own fonts, but a standalone
build doesn't, and could crash or render icons incorrectly without it.
---
 mobile/package-lock.json | 7 ++++---
 mobile/package.json      | 1 +
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/mobile/package-lock.json b/mobile/package-lock.json
index 111923a0..19cd9e04 100644
--- a/mobile/package-lock.json
+++ b/mobile/package-lock.json
@@ -17,6 +17,7 @@
         "expo-constants": "~57.0.3",
         "expo-device": "~57.0.0",
         "expo-document-picker": "~57.0.0",
+        "expo-font": "~57.0.0",
         "expo-image-picker": "~57.0.2",
         "expo-linking": "~57.0.2",
         "expo-location": "~57.0.2",
@@ -3686,9 +3687,9 @@
       }
     },
     "node_modules/expo-font": {
-      "version": "57.0.0",
-      "resolved": "https://registry.npmjs.org/expo-font/-/expo-font-57.0.0.tgz",
-      "integrity": "sha512-zF+J7WrNFjqyAADwdvDgkFEoIQv9DqcjJ57HVstNEH7/7Tx1ThPEhKraodEQOwSjMYWirP+4BYsVbdb+/Zr4QQ==",
+      "version": "57.0.1",
+      "resolved": "https://registry.npmjs.org/expo-font/-/expo-font-57.0.1.tgz",
+      "integrity": "sha512-QyS9L1Kh9sKJg4gfU6rdbpxpmH+DyzBX8z6jVvXMUDoqLr1GqmkO/Wu379KCXjL///kWbhpNlbi7AgBuj4VdIQ==",
       "license": "MIT",
       "dependencies": {
         "fontfaceobserver": "^2.1.0"
diff --git a/mobile/package.json b/mobile/package.json
index 1caa0b8a..1a56c3d0 100644
--- a/mobile/package.json
+++ b/mobile/package.json
@@ -12,6 +12,7 @@
     "expo-constants": "~57.0.3",
     "expo-device": "~57.0.0",
     "expo-document-picker": "~57.0.0",
+    "expo-font": "~57.0.0",
     "expo-image-picker": "~57.0.2",
     "expo-linking": "~57.0.2",
     "expo-location": "~57.0.2",
-- 
